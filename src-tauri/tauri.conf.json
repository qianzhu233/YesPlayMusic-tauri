{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "yesplaymusic-tauri",
  "version": "0.4.10",
  "identifier": "com.yesplaymusictauri.app",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:8080",
    "beforeDevCommand": "node scripts/tauri-dev-server.js",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "yesplaymusic-tauri",
        "width": 800,
        "height": 600,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../build/icons/32x32.png",
      "../build/icons/128x128.png",
      "../build/icons/128x128@2x.png",
      "../build/icons/icon.icns",
      "../build/icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "REPLACE_WITH_MINISIGN_PUBKEY",
      "endpoints": []
    }
  }
}
